# Leave VITE_API_BASE_URL empty in local development to use the Vite /api proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080

VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
VITE_VIETMAP_TILE_KEY=replace-with-vietmap-tile-key
VITE_VIETMAP_API_KEY=replace-with-vietmap-api-key
VITE_VIETMAP_SERVICE_KEY=replace-with-vietmap-service-key
